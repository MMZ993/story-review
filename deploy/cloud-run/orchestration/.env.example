# Agent Engine release pointers for the deployed orchestration service
# (D25). Copy to .env (gitignored) and fill from the deploy outputs in
# docs-local/runbooks/14-gcp-deployment.md §"Deployed resources".
# RESOURCE = projects/$PROJECT_ID/locations/$REGION/reasoningEngines/<id>
# VERSION  = the engine's deploy label (<slug>-<short-sha>), used as the
#            audit agent_version in AE mode.
ORCH_AE_BUSINESS_RESOURCE=
ORCH_AE_BUSINESS_VERSION=
ORCH_AE_ENGINEERING_RESOURCE=
ORCH_AE_ENGINEERING_VERSION=
ORCH_AE_SYNTHESIS_RESOURCE=
ORCH_AE_SYNTHESIS_VERSION=
ORCH_AE_FACILITATOR_RESOURCE=
ORCH_AE_FACILITATOR_VERSION=
# IAM signing principal for live V4 signed URLs (sa with TokenCreator on itself)
ORCH_SIGNER_EMAIL=sa-orchestration@<project-id>.iam.gserviceaccount.com
