# deploy/env/.env.example — local compose profile configuration.
# Copy to deploy/env/.env (gitignored) and adjust as needed; unset values
# fall back to the defaults in deploy/docker-compose.yml.

# Host port for the fake GCS substitute (container-internal use is 4443).
FAKE_GCS_PORT=9025

# Host ports for the three MCP services.
STORY_PORT=8101
ARTIFACT_PORT=8102
REPORT_PORT=8103

# Shared artifact bucket name (artifact server writes, report server reads).
ARTIFACT_BUCKET=artifacts-local

# --- local-agents profile (Phase 5) -----------------------------------
# Host ports for the four ADK agent adapters.
BUSINESS_REVIEWER_PORT=8111
ENGINEERING_REVIEWER_PORT=8112
SYNTHESIS_PORT=8113
FACILITATOR_PORT=8114

# Vertex AI project for the adapter containers (ADC is bind-mounted by the
# compose profile; no keys). The location matches the agents' config.yaml.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west4
