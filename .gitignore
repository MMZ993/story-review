# local identifiers — never commit
infra/envs/*.env
infra/envs/*.tfvars
.env
# local compose config (copy of deploy/env/.env.example)
deploy/env/.env

# terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# build staging contexts (per docs/operations/repository-layout.md)
build/

# local-only environment description; never commit
WORKING_ENVIRONMENT.md

# scratch
trash/

# python caches
__pycache__/
.pytest_cache/

# local cloud-run deploy overrides
deploy/cloud-run/*/.env

# node (webui frontend dev tooling)
node_modules/

# capstone source docs - stay local only
docs/source/

# evaluation run artifacts (kept locally, never committed)
tests/evaluation/artifacts/
