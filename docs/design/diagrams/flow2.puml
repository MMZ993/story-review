@startuml
participant PO
participant "FastAPI" as F
database "CloudSQL" as C
participant "ArtifactMCP" as A
participant "Facilitator" as T
participant "BusReview" as B
participant "EngReview" as E
participant "Synthesis" as Y
loop until gate: continue / finalize / park
PO -> F: message (session ID)
F -> C: resume session + turn lock (lease TTL 5 min)
C --> F: session + artifact references
F -> A: fetch story + latest artifacts per perspective (session lineage)
A --> F: artifacts (payloads)
F -> T: invoke (session context)
T --> F: reply + DelegationDecision
F -> C: persist turn + decision
alt invoke = both reviewers (parallel)
F -> B: invoke (story + prev + extra_context)
F -> E: invoke (story + prev + extra_context)
B --> F: review
E --> F: review
F -> A: save review artifacts (idempotent)
else invoke = single reviewer (business or engineering)
F -> B: invoke affected reviewer (story + prev + extra_context)
B --> F: review
F -> A: save review artifact (idempotent)
else reuse_previous = true
else invoke = none (dialogue only)
end
opt new artifacts exist or reuse_previous
F -> A: fetch latest per perspective (pairing done here)
F -> Y: invoke synthesis (latest per perspective)
Y --> F: synthesis report
F -> A: save synthesis artifact (idempotent)
F -> C: append synthesis to session context (deterministic)
end
F -> C: readiness gate (deterministic)
F --> PO: reply + updated synthesis + gate outcome (single response)
end
note right of F
gate: open_issues empty AND invoke=none
-> finalize (flow 3);
po_accepted (client action) -> finalize;
loop cap 10 -> park (no gate)
end note
@enduml
