    "fields": {
      "Microsoft.VSTS.Common.AcceptanceCriteria": "<p>Given a delivery fails (timeout, 5xx), when the failure is detected, then the system redelivers automatically without manual action. </p><p>Given redeliveries are exhausted, when the last attempt fails, then the event lands on the dead-letter queue and pages the on-call integration owner; nothing is silently lost. </p>",
      "Microsoft.VSTS.Common.Priority": 2,
      "Microsoft.VSTS.Common.StateChangeDate": "2026-09-08T14:05:02.047Z",
      "Microsoft.VSTS.Common.ValueArea": "Business",
